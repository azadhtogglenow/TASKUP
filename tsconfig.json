{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleDetection": "force",
    
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@types/*": ["./src/types/*"],
      "@db/*": ["./src/db/*"],
      "@queue/*": ["./src/queue/*"],
      "@services/*": ["./src/services/*"],
      "@routes/*": ["./src/routes/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*"],  // Only include src folder
  "exclude": [
    "node_modules",
    "dist",
    "drizzle.config.ts",  // Exclude drizzle config
    "*.config.ts"        // Or exclude all config files
  ]
}