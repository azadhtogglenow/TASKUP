{
  "name": "document-api",
  "version": "1.0.0",
  "description": "Document Management API with Express, JWT, Zod, and Drizzle ORM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev -r dotenv/config --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx ts-node scripts/migrate-runner.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node scripts/seed.ts",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down -v"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.30.10",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.21.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
