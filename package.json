{
  "name": "agent-demo",
  "version": "1.0.0",
  "description": "Educational AI agent backend: Function Calling vs LangGraph vs MCP, PostgreSQL 17 + Drizzle ORM",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "mcp:server": "tsx src/mcp/server.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector npx tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/openai": "^1.5.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "express": "^4.22.2",
    "groq-sdk": "^1.6.0",
    "openai": "^4.104.0",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
