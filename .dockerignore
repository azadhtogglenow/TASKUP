.drizzle/
*.db
*.sqlite

# --- Docker & Persistent Volumes ---
# Blocks local database/storage files from climbing into Git repositories
.docker/
postgres_data/
redis_data/
minio_data/

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System & IDE Files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
